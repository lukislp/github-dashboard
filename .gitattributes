###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

# Always save shell scripts and Linux config files with LF
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
.env*       text eol=lf
Dockerfile  text eol=lf

# Self-hosted web fonts are binary; never let line-ending normalization touch them.
*.woff2     binary
