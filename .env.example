# GitHub OAuth App (Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Random secret used to sign cookies and to encrypt tokens at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Public URL of this app. The OAuth callback is <BASE_URL>/auth/callback.
BASE_URL=http://localhost:8000

# --- optional ---
# Scopes requested from GitHub. "repo" is needed for private repositories and their workflow runs.
# GITHUB_SCOPES=repo read:org
# Restrict access to these GitHub logins (comma separated). Empty = every GitHub account may sign in.
# ALLOWED_LOGINS=
# Seconds an overview is served from cache before GitHub is asked again.
# CACHE_TTL_SECONDS=120
# Hours a login stays valid.
# SESSION_TTL_HOURS=168
# Number of recent workflow runs inspected per repository.
# RUNS_PER_REPO=5
# Parallel GitHub requests per overview refresh.
# MAX_CONCURRENCY=8
# Days without activity before a pull request or issue is flagged stale.
# STALE_DAYS=14
# Minutes an active workflow run may take before it is flagged long-running.
# LONG_RUN_MINUTES=30
# SQLite file for sessions (single replica). Ignored when REDIS_URL is set.
# DB_PATH=./data/sessions.db
# Redis for sessions + cache (multi replica).
# REDIS_URL=redis://redis:6379/0
